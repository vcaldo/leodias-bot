# ─── transcribe-api ──────────────────────────────────────────────
# Backend: faster-whisper (default) or whisper-cpp.
# whisper-cpp expects the whisper-cli binary and a ggml model in the
# container/host (WHISPER_CPP_BIN, WHISPER_CPP_MODEL_PATH).
TRANSCRIBE_BACKEND=faster-whisper
WHISPER_MODEL=small                 # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8           # int8 | int8_float16 | float16 | float32
WHISPER_LANGUAGE_DEFAULT=pt
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=1800
API_KEY=change-me                   # shared: API requires it, bot sends it
PORT=8000
LOG_LEVEL=info

# ─── leodias-bot ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Inside docker compose the default (http://transcribe-api:8000/v1/transcribe)
# is correct; override to point at another deploy (Pi, Linode, ...).
TRANSCRIBE_API_URL=http://transcribe-api:8000/v1/transcribe
TRANSCRIBE_TIMEOUT_SECONDS=120
TRANSCRIBE_FALLBACK_URL=
MAX_FILE_SIZE_MB=25
BLACKLIST_USER_IDS=                 # comma-separated Telegram user IDs to ignore

# ─── New Relic (single license key, one entity per service) ─────
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=true
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_API_APP_NAME=transcribe-api
NEW_RELIC_BOT_APP_NAME=leodias-bot
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_LABELS=                   # e.g. env:prod;host:pi5
